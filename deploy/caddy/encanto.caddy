# Bloques de Encanto Pacífico para el Caddy que ya sirve el VPS.
#
# Se importan desde /opt/agenda/Caddyfile con una sola línea al final:
#     import /opt/encanto/deploy/caddy/encanto.caddy
#
# Así los dos proyectos conviven sin mezclar configuración: si un día se
# retira uno, se borra su import y nada más.
#
# Caddy pide y renueva los certificados solo. No hay certbot ni cron.
#
# Los nombres de destino son alias de red, no de contenedor: los define el
# stack en docker-compose.stack.yml y sobreviven a un redespliegue.

# ── Producción · tienda ──────────────────────────────────────────────────────
encantopacificoerp.online, www.encantopacificoerp.online {
	encode gzip
	reverse_proxy encanto-prod-storefront:80
	request_body {
		max_size 10MB
	}
	log {
		output file /var/log/caddy/encanto-tienda.log {
			roll_size 20MB
			roll_keep 5
		}
	}
}

# ── Producción · panel administrativo ────────────────────────────────────────
admin.encantopacificoerp.online {
	encode gzip
	reverse_proxy encanto-prod-erp:80
	request_body {
		max_size 10MB
	}
	log {
		output file /var/log/caddy/encanto-erp.log {
			roll_size 20MB
			roll_keep 5
		}
	}
}

# ── Desarrollo · tienda ──────────────────────────────────────────────────────
# Protegido y fuera de los buscadores: es un ambiente de pruebas, no una
# segunda tienda. Indexarlo sería contenido duplicado y expondría ensayos.
dev.encantopacificoerp.online {
	encode gzip
	basic_auth {
		equipo REEMPLAZAR_POR_HASH
	}
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy encanto-dev-storefront:80
	request_body {
		max_size 10MB
	}
}

# ── Desarrollo · panel administrativo ────────────────────────────────────────
dev-admin.encantopacificoerp.online {
	encode gzip
	basic_auth {
		equipo REEMPLAZAR_POR_HASH
	}
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy encanto-dev-erp:80
	request_body {
		max_size 10MB
	}
}
