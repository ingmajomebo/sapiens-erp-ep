# ── Producción ───────────────────────────────────────────────────────────────
# Copiar a deploy/env/prod.env en el VPS y rellenar. NUNCA se commitea.

STACK_NAME=encanto-prod
REGISTRY=ghcr.io/ingmajomebo

# Etiqueta de imagen que está en producción. La cambia deploy/promote.sh.
IMAGE_TAG=

ERP_PORT=8081
STOREFRONT_PORT=8080

# Los dominios y la protección de desarrollo se configuran en el borde:
#   deploy/edge/sites/encanto.caddy

PGDATABASE=sapiens_erp
PGUSER=sapiens
# openssl rand -base64 32
PGPASSWORD=CAMBIAR

# Mínimo 64 bytes (HS512). Generar con: openssl rand -base64 48
# El backend NO arranca en producción si falta, es corta, o es el
# valor por defecto del repositorio. Distinta en cada ambiente.
JWT_SECRET=CAMBIAR

# Orígenes reales, separados por coma, sin barra final
CORS_ORIGIN=https://encantopacificoerp.online,https://admin.encantopacificoerp.online

# Administrador inicial. Obligatorio en producción: si no se define,
# el backend no crea ningún usuario y nadie puede entrar.
ADMIN_EMAIL=tu-correo@encantopacificoerp.online
# Mínimo 12 caracteres. Generar con: openssl rand -base64 18
ADMIN_PASSWORD=CAMBIAR

AI_ANTHROPIC_API_KEY=

# ---- Facturación electrónica (DIAN) ----
# El proveedor es intercambiable. `none` la deja apagada, y el ERP funciona
# igual: las facturas simplemente no se radican ante la DIAN.
#
# OJO: aquí los comentarios van en su propia línea. `--env-file` NO recorta
# lo que va después del valor, así que "none  # none | matias" se leería
# entero como el nombre del proveedor.
#
# Valores: none | matias
EINVOICING_PROVIDER=none
# Valores: sandbox | production
EINVOICING_ENVIRONMENT=sandbox
# Personal Access Token del proveedor. Las credenciales de sandbox NO sirven
# en producción ni al revés.
EINVOICING_TOKEN=
# Vacío usa la URL del ambiente elegido.
EINVOICING_BASE_URL=

# Datos del emisor, tal como figuran en la resolución de la DIAN.
# NIT sin dígito de verificación
EINVOICING_ISSUER_TAX_ID=
# Número de resolución de facturación
EINVOICING_ISSUER_RESOLUTION=
# Prefijo autorizado, p. ej. FEV
EINVOICING_ISSUER_PREFIX=
EINVOICING_ISSUER_RANGE_FROM=
EINVOICING_ISSUER_RANGE_TO=

# Código DANE de municipio y código postal que se envían cuando el cliente
# no los tiene. Medellín es 05001 / 050001.
EINVOICING_DEFAULT_CITY_ID=
EINVOICING_DEFAULT_POSTAL_CODE=
