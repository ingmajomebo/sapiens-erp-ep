# ── Desarrollo ──────────────────────────────────────────────────────────────
# Copiar a deploy/env/dev.env en el VPS y rellenar. NUNCA se commitea.

STACK_NAME=encanto-dev
REGISTRY=ghcr.io/ingmajomebo

# Etiqueta de imagen que está en producción. La cambia deploy/promote.sh.
IMAGE_TAG=

ERP_PORT=8091
STOREFRONT_PORT=8090

# ── Enrutamiento en el proxy de borde ────────────────────────────────────────
STORE_RULE=Host(`dev.encantopacificoerp.online`)
ERP_HOST=dev-admin.encantopacificoerp.online
# Desarrollo: además de seguridad, fuera de buscadores y tras contraseña.
EDGE_MIDDLEWARES=encanto-dev-sec@docker,encanto-dev-noindex@docker,encanto-dev-auth@docker
# Generar con:
#   docker run --rm httpd:alpine htpasswd -nbB equipo 'TU_CLAVE'
# Duplicar cada $ como $$ para que docker compose no lo interprete.
DEV_BASIC_AUTH=

PGDATABASE=sapiens_erp_dev
PGUSER=sapiens
# openssl rand -base64 32
PGPASSWORD=CAMBIAR

# openssl rand -base64 48 — DISTINTO al de desarrollo
JWT_SECRET=CAMBIAR

# Orígenes reales, separados por coma, sin barra final
CORS_ORIGIN=https://dev.encantopacificoerp.online,https://dev-admin.encantopacificoerp.online

# Administrador inicial. Obligatorio en producción: si no se define,
# el backend no crea ningún usuario y nadie puede entrar.
ADMIN_EMAIL=tu-correo@encantopacificoerp.online
# Mínimo 12 caracteres. Generar con: openssl rand -base64 18
ADMIN_PASSWORD=CAMBIAR

AI_ANTHROPIC_API_KEY=
