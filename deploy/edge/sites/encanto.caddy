# Encanto Pacífico — tienda y panel, en sus dos ambientes.
#
# Los destinos son alias de red, no nombres de contenedor: los define
# docker-compose.stack.yml y sobreviven a un redespliegue.

# ── Producción · tienda ──────────────────────────────────────────────────────
encantopacificoerp.online, www.encantopacificoerp.online {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy encanto-prod-storefront:80

	request_body {
		max_size 10MB
	}

	log {
		output file /var/log/caddy/encanto-tienda.log {
			roll_size 20MB
			roll_keep 5
		}
	}
}

# ── Producción · panel administrativo ────────────────────────────────────────
admin.encantopacificoerp.online {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy encanto-prod-erp:80

	request_body {
		max_size 10MB
	}

	log {
		output file /var/log/caddy/encanto-erp.log {
			roll_size 20MB
			roll_keep 5
		}
	}
}

# ── Desarrollo ───────────────────────────────────────────────────────────────
# Tras contraseña y fuera de los buscadores: es un ambiente de pruebas, no una
# segunda tienda. Indexarlo sería contenido duplicado y expondría ensayos.
#
# Generar el hash con:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'TU_CLAVE'

dev.encantopacificoerp.online {
	encode gzip

	basic_auth {
		equipo REEMPLAZAR_POR_HASH
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy encanto-dev-storefront:80

	request_body {
		max_size 10MB
	}
}

dev-admin.encantopacificoerp.online {
	encode gzip

	basic_auth {
		equipo REEMPLAZAR_POR_HASH
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy encanto-dev-erp:80

	request_body {
		max_size 10MB
	}
}
