# Encanto Pacífico — ambiente de DESARROLLO.  (PLANTILLA)
#
# Este archivo termina en .example a propósito: el borde solo recoge *.caddy,
# así que mientras no lo actives no puede afectar a nada.
#
# Para activarlo, en el servidor:
#   1. docker run --rm caddy:2-alpine caddy hash-password --plaintext 'TU_CLAVE'
#   2. reemplazar PEGAR_AQUI_EL_HASH en los dos bloques
#   3. cp encanto-dev.caddy.example encanto-dev.caddy
#   4. ./deploy/edge/apply-sites.sh
#
# El candado básico cubre la PÁGINA, nunca /api/*.
#
# Motivo: HTTP tiene una sola cabecera Authorization. Caddy la usa para el
# candado básico y la aplicación la usa para el token JWT. Si el candado
# cubriera /api/*, cada llamada de la app llegaría con "Bearer ..." donde Caddy
# espera "Basic ...", y Caddy respondería 401 sin pasarla al backend: se puede
# iniciar sesión pero ninguna pantalla carga.
#
# La API no queda desprotegida: exige JWT por su cuenta, que es la barrera real.
# El candado solo evita que un curioso o un buscador vea el ambiente de pruebas.

# ── Desarrollo · tienda ──────────────────────────────────────────────────────
dev.encantopacificoerp.online {
	encode gzip

	@pagina not path /api/*
	basic_auth @pagina {
		equipo PEGAR_AQUI_EL_HASH
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy encanto-dev-storefront:80

	request_body {
		max_size 10MB
	}
}

# ── Desarrollo · panel administrativo ────────────────────────────────────────
dev-admin.encantopacificoerp.online {
	encode gzip

	@pagina not path /api/*
	basic_auth @pagina {
		equipo PEGAR_AQUI_EL_HASH
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy encanto-dev-erp:80

	request_body {
		max_size 10MB
	}
}
