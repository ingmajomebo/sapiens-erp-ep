# Plantilla de variables de producción.
# En el VPS:  cp .env.example .env  y rellena los valores reales.
# El archivo .env NUNCA se commitea (ya está en .gitignore).

# ---- Base de datos ----
PGDATABASE=sapiens_erp
PGUSER=sapiens
# Generar con:  openssl rand -base64 32
PGPASSWORD=CAMBIAR_password_fuerte

# ---- Seguridad ----
# Mínimo 32 caracteres. Generar con:  openssl rand -base64 48
JWT_SECRET=CAMBIAR_secreto_jwt_min_32_caracteres

# ---- Dominio ----
# Origen exacto del frontend, con https y sin barra final
CORS_ORIGIN=https://tudominio.com

# ---- Opcional ----
AI_ANTHROPIC_API_KEY=
